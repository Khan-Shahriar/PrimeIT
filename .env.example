NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
CLIENT_ORIGIN=http://localhost:8080
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
